---
// Terms of use: plain-language draft for legal review. Services and training have their own written agreements.
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import { company } from '../data/site';
import { formatDate } from '../data/posts';

const updated = '2026-10-23';
const toc = [
  { id: 'short-version', title: 'The short version' },
  { id: 'using-the-site', title: 'Using this site' },
  { id: 'information', title: 'Information on this site' },
  { id: 'free-tools', title: 'Free tools' },
  { id: 'content', title: 'Our content and logos' },
  { id: 'links', title: 'Links to other websites' },
  { id: 'liability', title: 'Limits of liability' },
  { id: 'privacy', title: 'Privacy' },
  { id: 'law', title: 'Governing law' },
  { id: 'changes', title: 'Changes to these terms' },
  { id: 'contact', title: 'Contact' },
];
const title = (id: string) => toc.find((t) => t.id === id)?.title ?? id;
---
<Base
  title="Terms of use"
  description="The terms for using gforceit.ca: how the information on the site may be used, the free tools, links to other websites, limits of liability and Ontario law."
>
  <div class="legal">
    <PageHero
      tone="light"
      lines={['Terms of use']}
      intro="The rules for using gforceit.ca. Our services and training are covered by their own written agreements."
    >
      <div class="legal-meta">
        <p class="legal-updated t-meta">Last updated <time datetime={updated}>{formatDate(updated)}</time></p>
      </div>
    </PageHero>

    <div class="legal-body">
      <div class="container-g legal-grid">
        <nav class="legal-toc legal-toc-wide" aria-label="On this page">
          <p class="legal-toc-title t-meta">On this page</p>
          <ul role="list">{toc.map((t) => <li><a href={`#${t.id}`}>{t.title}</a></li>)}</ul>
        </nav>
        <nav class="legal-toc legal-toc-narrow" aria-label="On this page">
          <details>
            <summary>On this page</summary>
            <ul role="list">{toc.map((t) => <li><a href={`#${t.id}`}>{t.title}</a></li>)}</ul>
          </details>
        </nav>

        <article class="legal-prose">
          <section id="short-version" aria-labelledby="short-version-h">
            <h2 id="short-version-h">{title('short-version')}</h2>
            <ul>
              <li>You can use this site to learn about our services and training, use the free tools and get in touch.</li>
              <li>The information here is general. Your written agreement with us, not this website, sets the terms of any work.</li>
              <li>The free tools give estimates, not professional advice.</li>
              <li>Ontario law applies.</li>
            </ul>
          </section>

          <section id="using-the-site" aria-labelledby="using-the-site-h">
            <h2 id="using-the-site-h">{title('using-the-site')}</h2>
            <p>
              These terms apply to the website at gforceit.ca, run by {company.legalName} (“G-Force”, “we”).
              By using the site you agree to them. If you don’t agree, please don’t use the site.
            </p>
            <p>When you use the site, please don’t:</p>
            <ul>
              <li>try to break into, overload or disrupt the site or the systems behind it;</li>
              <li>send spam or harmful code through our forms or chat;</li>
              <li>send us someone else’s personal information without their permission;</li>
              <li>copy the site in bulk, including with automated tools, or present our content as your own.</li>
            </ul>
          </section>

          <section id="information" aria-labelledby="information-h">
            <h2 id="information-h">{title('information')}</h2>
            <p>
              We work to keep the site accurate and up to date, but the information is general and can change without notice.
              It isn’t professional, legal or financial advice for your situation.
            </p>
            <ul>
              <li>Service descriptions are summaries. The scope, response targets and price of any work are set in your written agreement with us.</li>
              <li>Course content, formats, schedules and prices can change. What you enrol in is confirmed in writing before you pay.</li>
            </ul>
          </section>

          <section id="free-tools" aria-labelledby="free-tools-h">
            <h2 id="free-tools-h">{title('free-tools')}</h2>
            <p>
              The <a href="/it-health-check/">IT health check</a>, the <a href="/business/#downtime-calculator">downtime cost calculator</a>{' '}
              and the <a href="/resources/security-checklist/">security checklist</a> give general estimates and guidance based only on what you
              enter. They aren’t an audit, a security assessment or a guarantee. For a look at your own systems, book the{' '}
              <a href="/contact/?interest=assessment#contact-form">free IT assessment</a>.
            </p>
          </section>

          <section id="content" aria-labelledby="content-h">
            <h2 id="content-h">{title('content')}</h2>
            <p>
              The text, design, photographs and films on this site, and the G-Force name and winged-G logo, belong to G-Force or are
              used under licence. You’re welcome to link to any page and to quote short passages with credit. Please ask us before
              reusing anything else.
            </p>
            <p>Other companies’ names and logos belong to their owners and appear only to identify them.</p>
          </section>

          <section id="links" aria-labelledby="links-h">
            <h2 id="links-h">{title('links')}</h2>
            <p>
              We link to other websites, such as OpenStreetMap and the Canadian Centre for Cyber Security, when they’re useful.
              We don’t control those sites and aren’t responsible for their content or how they handle your information.
              A link isn’t an endorsement.
            </p>
          </section>

          <section id="liability" aria-labelledby="liability-h">
            <h2 id="liability-h">{title('liability')}</h2>
            <p>We provide this site “as is”. We don’t promise that it will always be available or free of errors.</p>
            <p>
              To the extent the law allows, G-Force isn’t liable for any loss or damage that comes from using this site, from not being
              able to use it, or from relying on its content, including lost data, lost revenue or business interruption.
              Nothing in these terms limits any liability that the law doesn’t allow us to limit.
            </p>
            <p>Work we do for clients and learners is governed by its own agreement, including its own terms about liability.</p>
          </section>

          <section id="privacy" aria-labelledby="privacy-h">
            <h2 id="privacy-h">{title('privacy')}</h2>
            <p>How we handle the information you send us is explained in our <a href="/privacy/">privacy policy</a>.</p>
          </section>

          <section id="law" aria-labelledby="law-h">
            <h2 id="law-h">{title('law')}</h2>
            <p>
              These terms are governed by the laws of the Province of Ontario and the federal laws of Canada that apply there.
              Any dispute about this website will be heard by the courts of Ontario, sitting in Toronto.
            </p>
          </section>

          <section id="changes" aria-labelledby="changes-h">
            <h2 id="changes-h">{title('changes')}</h2>
            <p>
              We may update these terms. The date at the top shows when they last changed. Using the site after a change means you
              accept the updated terms.
            </p>
          </section>

          <section id="contact" aria-labelledby="contact-h">
            <h2 id="contact-h">{title('contact')}</h2>
            <p>
              Questions about these terms: <a href={`mailto:${company.email}`}>{company.email}</a> or{' '}
              <a href={company.phoneHref}>{company.phoneDisplay}</a>, or write to us at:
            </p>
            <address class="legal-address">
              {company.legalName}<br />
              {company.address.street}<br />
              {company.address.city}, {company.address.region} {company.address.postal}
            </address>
          </section>
        </article>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Legal pages (privacy, terms, accessibility) share this layout. Light by default; in the dark theme the
     PageHero's light band follows the theme too, so the long read never flips to a bright page. */
  :global([data-theme='dark']) .legal :global(.band-light) {
    color-scheme: inherit;
    --bg: inherit;
    --surface: inherit;
    --surface-2: inherit;
    --text: inherit;
    --text-muted: inherit;
    --line: inherit;
    --line-strong: inherit;
    --accent: inherit;
    --accent-hover: inherit;
    --accent-press: inherit;
    --btn-text: inherit;
    --accent-ink: inherit;
    --accent-tint: inherit;
    --focus: inherit;
    --logo-word: inherit;
  }
  .legal-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
  }
  .legal-draft {
    padding: 0.55rem 1rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .legal-updated {
    color: var(--text-muted);
  }
  .legal-body {
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem) var(--section-y);
  }
  .legal-grid {
    display: grid;
    gap: 2rem;
  }

  /* On this page: a sticky list beside the text on wide screens, a collapsed list on phones. */
  .legal-toc ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .legal-toc a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.35rem 0 0.35rem 1rem;
    border-left: 1px solid var(--line);
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.35;
    text-decoration: none;
    transition:
      color 160ms var(--ease-out-quart),
      border-color 160ms var(--ease-out-quart);
  }
  .legal-toc a:hover {
    border-left-color: var(--text);
    color: var(--text);
  }
  .legal-toc-title {
    margin-bottom: 0.75rem;
    color: var(--text);
    font-weight: 650;
  }
  .legal-toc-wide {
    display: none;
  }
  .legal-toc-narrow details {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .legal-toc-narrow summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-card);
    font-weight: 650;
    cursor: pointer;
    list-style: none;
  }
  .legal-toc-narrow summary::-webkit-details-marker {
    display: none;
  }
  .legal-toc-narrow summary::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.25rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-25%) rotate(45deg);
    transition: transform 220ms var(--ease-out-expo);
  }
  .legal-toc-narrow details[open] summary::after {
    transform: translateY(25%) rotate(225deg);
  }
  .legal-toc-narrow ul {
    padding: 0 1rem 0.75rem;
  }

  /* Prose */
  .legal-prose {
    max-width: 68ch;
    min-width: 0;
  }
  .legal-prose section {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .legal-prose section + section {
    margin-top: clamp(2.25rem, 1.75rem + 2vw, 3.25rem);
    padding-top: clamp(2.25rem, 1.75rem + 2vw, 3.25rem);
    border-top: 1px solid var(--line);
  }
  .legal-prose h2 {
    margin-bottom: 1rem;
    font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .legal-prose h3 {
    margin: 2rem 0 0.75rem;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .legal-prose p + p,
  .legal-prose p + ul,
  .legal-prose ul + p,
  .legal-prose p + address,
  .legal-prose address + p,
  .legal-prose p + .legal-table {
    margin-top: 1rem;
  }
  .legal-prose ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding-left: 1.2rem;
    list-style: disc;
  }
  .legal-prose li {
    padding-left: 0.25rem;
  }
  .legal-prose li::marker {
    color: var(--accent-ink);
  }
  .legal-prose a {
    color: var(--text);
    font-weight: 550;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: color 160ms var(--ease-out-quart);
  }
  .legal-prose a:hover {
    color: var(--accent-ink);
  }
  .legal-prose strong {
    font-weight: 700;
  }
  .legal-prose code {
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
    background: var(--surface-2);
    font-size: 0.9em;
  }
  .legal-prose .sample-badge {
    margin-left: 0.15rem;
    vertical-align: 0.1em;
  }
  .legal-list {
    margin: 0;
  }
  .legal-list > div {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }
  .legal-list > div:first-child {
    padding-top: 0.25rem;
    border-top: 0;
  }
  .legal-list dt {
    font-weight: 700;
  }
  .legal-list dd {
    margin: 0;
  }
  .legal-address {
    padding-left: 1rem;
    border-left: 1px solid var(--line-strong);
    font-style: normal;
    line-height: 1.6;
  }

  /* Data table: three columns on wide screens; on phones each row becomes a labelled block. */
  .legal-table {
    width: 100%;
    margin-top: 1.25rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .legal-table th,
  .legal-table td {
    padding: 0.95rem 1.25rem 0.95rem 0;
    border-top: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .legal-table thead th {
    padding-block: 0 0.65rem;
    border-top: 0;
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 650;
  }
  .legal-table tbody th {
    width: 24%;
    font-weight: 700;
  }
  .legal-table td:last-child,
  .legal-table th:last-child {
    padding-right: 0;
  }

  @media (max-width: 719px) {
    .legal-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .legal-table tr {
      display: block;
      padding-block: 1rem;
      border-top: 1px solid var(--line);
    }
    .legal-table tbody th,
    .legal-table td {
      display: block;
      width: auto;
      padding: 0;
      border: 0;
    }
    .legal-table td::before {
      content: attr(data-label);
      content: attr(data-label) / '';
      display: block;
      margin-top: 0.6rem;
      color: var(--text-muted);
      font-size: 0.8125rem;
      font-weight: 650;
    }
  }
  @media (min-width: 720px) {
    .legal-list > div {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .legal-grid {
      grid-template-columns: 14.5rem minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
    .legal-toc-wide {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
    .legal-toc-narrow {
      display: none;
    }
  }
</style>
