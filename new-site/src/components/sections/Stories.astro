---
// Proof in two registers: voices (large pull quotes) and case files that read
// Problem → Solution → Result. All content comes from site.ts. Anything flagged `sample` carries a
// Sample badge until G-Force supplies real, permissioned stories (PRODUCT.md "Truth rules").
// No stock faces: an initials disc stands in for a photo, tinted night (business) or dawn (learner).
//
// Reuse: <Stories compact /> on home; <Stories show="cases" /> on /business; <Stories show="voices" audience="learner" /> on /training.
// `compact` (home): the lead quote, one quote from the other audience and the first case, then a link to all of them.
import SplitHeading from '../ui/SplitHeading.astro';
import Picture from '../ui/Picture.astro';
import Icon from '../ui/Icon.astro';
import { testimonials, caseStudies, hero } from '../../data/site';

interface Props {
  id?: string;
  show?: 'all' | 'voices' | 'cases';
  audience?: 'all' | 'business' | 'learner';
  lines?: string[];
  compact?: boolean;
}

const { id = 'stories', show = 'all', audience = 'all', lines, compact = false } = Astro.props;

// Fields G-Force can add once real, permissioned stories arrive: name, photo (a media slot) and audience.
type Voice = (typeof testimonials.items)[number] & { name?: string; photo?: string; audience?: 'business' | 'learner' };
const pathOf = (t: Voice) =>
  t.audience ?? (/graduate|learner|student|switcher|track/i.test(`${t.who} ${t.org}`) ? 'learner' : 'business');

// Placeholder data is retained in site.ts, but never published as client proof.
const allVoices = (testimonials.sample ? [] : testimonials.items as Voice[]).filter((t) => audience === 'all' || pathOf(t) === audience);
// Compact: one business and one learner voice, so both paths are heard without the full wall.
const lead = allVoices[0];
const other = lead ? allVoices.find((t) => pathOf(t) !== pathOf(lead)) : undefined;
const voices = compact ? [lead, other].filter((t): t is Voice => Boolean(t)) : allVoices;
const approvedCases = caseStudies.sample ? [] : caseStudies.items;
const cases = compact ? approvedCases.slice(0, 1) : approvedCases;
const moreCases = caseStudies.items.length - cases.length;
const numberWords = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const allCasesLabel = `See all ${numberWords[caseStudies.items.length] ?? caseStudies.items.length} case studies`;

const showVoices = show !== 'cases' && voices.length > 0;
const showCases = show !== 'voices' && cases.length > 0;

const defaultLines =
  show === 'cases'
    ? ['Problems we fixed,', 'start to finish']
    : show === 'voices'
      ? audience === 'learner'
        ? ['Heard from', 'our learners']
        : audience === 'business'
          ? ['Heard from', 'our clients']
          : ['Heard from clients', 'and learners']
      : ['Stories from the office', 'and the classroom'];
const heading = lines ?? defaultLines;

const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
// With voices above, the case list gets its own h3 and each case is an h4; on its own, each case is an h3.
const CaseHeading = showVoices ? 'h4' : 'h3';
---
{(showVoices || showCases) && <section id={id} class:list={['stories', 'section-y', 'sheet', { 'is-compact': compact }]} aria-labelledby={`${id}-title`}>
  <div class="container-g">
    <div class="stories-intro">
      <SplitHeading id={`${id}-title`} as="h2" lines={heading} class="t-h2 stories-title" />
    </div>

    {showVoices && (
      <div class="voices">
        {voices.map((t, i) => (
          <figure
            class:list={['voice', i === 0 ? 'voice-lead' : 'voice-more', `path-${pathOf(t)}`]}
            data-reveal
            style={`--reveal-delay: ${i === 0 ? 100 : 60 + i * 110}ms`}
          >
            <blockquote class="voice-quote">
              <p>“{t.quote}”</p>
            </blockquote>
            <figcaption class="voice-by">
              {t.photo ? (
                <Picture slot={t.photo} alt="" sizes="48px" class="voice-face" />
              ) : (
                <span class="voice-initials" aria-hidden="true">{t.initials}</span>
              )}
              <span class="voice-who">
                <span class="voice-name">{t.name ?? t.who}</span><span class="sr-only">, </span><span class="voice-org">{t.name ? `${t.who}, ${t.org}` : t.org}</span>
              </span>{' '}
            </figcaption>
          </figure>
        ))}
      </div>
    )}

    {compact && !showCases && approvedCases.length > 0 && (
      <p class="cases-more">
        <a class="link-arrow" href="/business/#stories">
          See the case studies
          <span class="btn-arrow"><Icon name="arrow" size={18} /></span>
        </a>
      </p>
    )}

    {showCases && (
      <div class="cases">
        {showVoices && (
          <div class="cases-head" data-reveal>
            <h3 class="t-h3 cases-title">Case studies</h3>
            <p class="cases-format t-meta" aria-hidden="true">
              <span>Problem</span>
              <Icon name="arrow" size={14} />
              <span>Solution</span>
              <Icon name="arrow" size={14} />
              <span>Result</span>
            </p>
          </div>
        )}
        <ol class="case-list" role="list">
          {cases.map((c) => {
            const cid = `${id}-case-${slug(c.sector)}`;
            return (
              <li class="case">
                <article class="case-row" aria-labelledby={cid}>
                  <Picture
                    slot={c.image}
                    alt=""
                    reveal
                    class="case-media"
                    sizes="(min-width: 1024px) 26rem, (min-width: 640px) 40vw, 100vw"
                  />
                  <div class="case-body">
                    <div class="case-head">
                      <CaseHeading id={cid} class="t-h4 case-sector">{c.sector}</CaseHeading>
                    </div>
                    <dl class="case-steps" data-stagger>
                      <div class="step">
                        <dt>Problem</dt>
                        <dd>{c.problem}</dd>
                      </div>
                      <div class="step">
                        <dt>Solution</dt>
                        <dd>{c.solution}</dd>
                      </div>
                      <div class="step step-result">
                        <dt>
                          <Icon name="check" size={16} />
                          Result
                        </dt>
                        <dd>{c.result}</dd>
                      </div>
                    </dl>
                  </div>
                </article>
              </li>
            );
          })}
        </ol>

        {moreCases > 0 && (
          <p class="cases-more">
            <a class="link-arrow" href="/business/#stories">
              {allCasesLabel}
              <span class="btn-arrow"><Icon name="arrow" size={18} /></span>
            </a>
          </p>
        )}

        <p class="stories-cta" data-reveal>
          <span>The free assessment is a 30-minute conversation and a written report on your top risks, yours to keep.</span>{' '}
          <a class="link-arrow stories-cta-link" href={hero.primary.href}>
            {hero.primary.label}
            <span class="btn-arrow"><Icon name="arrow" size={18} /></span>
          </a>
        </p>
      </div>
    )}
  </div>
</section>}

<style>
  /* ---------- Intro ---------- */
  .stories-intro {
    display: grid;
    gap: 1.25rem;
  }
  .stories-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    max-width: 44ch;
    color: var(--text-muted);
  }

  /* ---------- Voices ---------- */
  .voices {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .voice {
    margin: 0;
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  /* Quotes are set in the text face: the script accent is for one headline word, never for sentences. */
  .voice-quote {
    margin: 0;
    font-weight: 430;
    color: var(--text);
  }
  /* Hanging punctuation: the opening mark sits in the margin so the text edge stays clean. */
  .voice-quote p {
    text-indent: -0.4em;
  }
  .voice-lead .voice-quote {
    font-size: clamp(1.5rem, 1.05rem + 1.8vw, 2.375rem);
    line-height: 1.22;
    letter-spacing: -0.025em;
    max-width: 30ch;
  }
  .voice-more {
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .voice-more .voice-quote {
    font-size: clamp(1.125rem, 1.02rem + 0.4vw, 1.3125rem);
    line-height: 1.45;
    letter-spacing: -0.012em;
    max-width: 42ch;
  }

  .voice-by {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.875rem;
  }
  .voice-initials,
  .voice-by :global(.voice-face) {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    overflow: hidden;
  }
  .voice-by :global(.voice-face img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .voice-initials {
    display: inline-grid;
    place-items: center;
    font-size: 0.875rem;
    font-weight: 620;
    letter-spacing: 0.04em;
  }
  /* Paths are told apart by temperature: a night disc for business, a sunrise disc for learners. */
  .path-business .voice-initials {
    color: #fff;
    background:
      radial-gradient(120% 120% at 28% 18%, var(--color-dusk-500) 0%, transparent 62%),
      var(--color-ink-900);
    box-shadow: inset 0 0 0 1px color-mix(in oklch, white 10%, transparent);
  }
  .path-learner .voice-initials {
    color: var(--color-ink-900);
    background: linear-gradient(155deg, var(--color-dawn-sky) 0%, var(--color-dawn-200) 48%, var(--color-dawn-400) 100%);
  }
  .voice-who {
    display: grid;
    line-height: 1.35;
  }
  .voice-name {
    font-weight: 600;
  }
  .voice-org {
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  /* ---------- Case studies ---------- */
  .cases {
    margin-top: clamp(4.5rem, 3rem + 5vw, 8rem);
  }
  .is-compact .cases {
    margin-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }
  .cases-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-bottom: 1.5rem;
  }
  .cases-format {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
  }
  .case-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .case-row {
    display: grid;
    gap: 1.5rem;
    padding-block: 2rem 2.25rem;
    border-top: 1px solid var(--line);
  }
  .case-row :global(.case-media) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .case-row :global(.case-media img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .case-body {
    container-type: inline-size;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .case-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .case-steps {
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }
  .step {
    position: relative;
    padding-top: 0.9rem;
  }
  /* Each step sits on its own rule; the result's rule carries the accent, the payoff of the sequence. */
  .step::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--line-strong);
    transform-origin: 0 50%;
  }
  .step-result::before {
    height: 2px;
    background: var(--accent-ink);
  }
  .step dt {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.45rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.3;
    color: var(--text-muted);
  }
  .step-result dt {
    color: var(--accent-ink);
  }
  .step dd {
    margin: 0;
    max-width: 52ch;
    font-size: 1rem;
    line-height: 1.55;
  }
  .step-result dd {
    font-weight: 600;
  }
  @container (min-width: 42rem) {
    .case-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .cases-more {
    margin-top: 1rem;
  }
  .cases-more .link-arrow {
    min-height: 2.75rem;
  }
  .stories-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 2rem;
    color: var(--text-muted);
  }
  .cases-more + .stories-cta {
    margin-top: 1.25rem;
  }
  .stories-cta > span {
    max-width: 52ch;
  }
  .stories-cta-link {
    min-height: 2.75rem;
  }

  /* ---------- Motion ---------- */
  /* Problem, solution, result arrive in order, and each rule draws as its step lands. */
  :global(.motion-ok) .case-steps > .step {
    transition-delay: calc(80ms + var(--i, 0) * 120ms);
  }
  :global(.motion-ok) .step::before {
    transform: scaleX(0);
    transition: transform 600ms var(--ease-out-expo);
    transition-delay: calc(160ms + var(--i, 0) * 120ms);
  }
  :global(.motion-ok) .case-steps.is-in .step::before {
    transform: none;
  }

  /* ---------- Layout ---------- */
  @media (min-width: 640px) {
    .case-row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 2rem;
      align-items: start;
    }
    .case-row :global(.case-media) {
      aspect-ratio: 3 / 2;
    }
  }
  @media (min-width: 768px) {
    .voices {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      row-gap: 3.5rem;
    }
    .voice-lead {
      grid-column: 1 / -1;
    }
    .voice-more {
      grid-column: span 6;
    }
  }
  @media (min-width: 1024px) {
    .stories-intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
      align-items: end;
      column-gap: 3rem;
    }
    .stories-note {
      justify-self: end;
      padding-bottom: 0.4rem;
    }
    /* Voices hang from a common left edge, indented from the heading. */
    .voice-lead {
      grid-column: 3 / -1;
    }
    .voice-more:nth-child(2) {
      grid-column: 3 / span 5;
    }
    .voice-more:nth-child(3) {
      grid-column: 8 / -1;
    }
    .voice-more:nth-child(n + 4) {
      grid-column: 3 / -1;
    }
    .case-row {
      gap: 3rem;
      padding-block: 2.5rem 2.75rem;
    }
  }
  /* Wide enough for the three steps to sit side by side: the image gives up a column. */
  @media (min-width: 1200px) {
    .case-row {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
</style>
