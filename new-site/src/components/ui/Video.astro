---
// Poster-first, silent inline media. The shared player owns loading, visibility,
// decoder limits and one short playback. Play/Retry appears only when needed;
// clips finish within 4.5 seconds and never expose a persistent pause control.
import { media } from '../../lib/media';
import Icon from './Icon.astro';
import Picture from './Picture.astro';

interface Props {
  slot: string;
  class?: string;
  mode?: 'hero' | 'inview' | 'hover';
  alt?: string;
  priority?: boolean;
  controls?: boolean;
  label?: string;
}

const { slot, class: className = '', mode = 'inview', alt = '', priority = false, controls = true, label = 'video', ...rest } = Astro.props;
const entry = media(slot);
const s = entry?.sources;
const poster = s?.poster?.jpg ?? s?.poster?.webp;
const videoId = `film-${slot}-${crypto.randomUUID().slice(0, 8)}`;
---
{entry?.kind === 'image' ? (
  <div class={`video-frame video-still ${className}`} {...rest}>
    <Picture slot={slot} alt={alt} mobileCrop class="video-still-picture" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
  </div>
) : entry && s && (s.mp4 || s.webm) ? (
  <div class={`video-frame ${className}`} data-video-frame {...rest}>
    <picture class="video-poster" aria-hidden="true">
      {s.poster?.avif && <source type="image/avif" srcset={s.poster.avif} />}
      {s.poster?.webp && <source type="image/webp" srcset={s.poster.webp} />}
      <img
        src={poster}
        alt=""
        width={entry.width ?? 1920}
        height={entry.height ?? 1080}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding={priority ? 'sync' : 'async'}
        style={entry.objectPosition ? `object-position: ${entry.objectPosition}` : undefined}
      />
    </picture>
    <video
      id={videoId}
      class="video-el"
      muted
      playsinline
      webkit-playsinline
      preload="none"
      disablepictureinpicture
      aria-hidden={alt ? undefined : 'true'}
      aria-label={alt || undefined}
      data-video-mode={mode}
      data-src-mp4={s.mp4}
      data-src-webm={s.webm}
      data-src-mobile={s.mp4Mobile}
      data-video-label={label}
      style={entry.objectPosition ? `object-position: ${entry.objectPosition}` : undefined}
    ></video>
    {controls && (
      <button type="button" class="video-toggle" data-video-toggle data-state="paused" aria-controls={videoId} aria-label={`Play ${label}`} title={`Play ${label}`} hidden>
        <span class="video-control-play" aria-hidden="true"><Icon name="play" size={18} /></span>
      </button>
    )}
    <span class="sr-only" data-video-status aria-live="polite"></span>
  </div>
) : (
  <div class={`video-frame video-fallback ${className}`} aria-hidden="true" {...rest}></div>
)}

<style>
  .video-frame {
    position: relative;
    overflow: hidden;
    background: var(--color-ink-900);
  }
  .video-still :global(.video-still-picture),
  .video-still :global(img),
  .video-poster,
  .video-poster img,
  .video-el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-el {
    opacity: 0;
    transition: opacity 300ms var(--ease-out-quart);
  }
  .video-el.is-playing {
    opacity: 1;
  }
  .video-toggle {
    position: absolute;
    inset-inline-end: 0.75rem;
    bottom: 0.75rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid color-mix(in oklab, white 36%, transparent);
    border-radius: 50%;
    background: var(--color-ink-900);
    color: white;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 160ms var(--ease-out-quart);
  }
  .video-toggle[hidden] { display: none; }
  .video-toggle:hover { background: var(--color-ink-950); }
  .video-toggle:focus-visible { outline: 3px solid white; outline-offset: 3px; }
  .video-toggle span { display: grid; }
  @media (prefers-reduced-motion: reduce) {
    .video-el { transition: none; }
  }
  .video-fallback {
    background:
      radial-gradient(90% 70% at 70% 20%, color-mix(in oklch, var(--color-dusk-500) 60%, transparent), transparent 65%),
      radial-gradient(60% 50% at 20% 90%, color-mix(in oklch, var(--color-crimson-500) 18%, transparent), transparent 70%),
      linear-gradient(180deg, var(--color-ink-900), var(--color-ink-950));
  }
</style>
