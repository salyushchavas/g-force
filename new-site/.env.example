# Optional client integrations. These values are public in the built frontend.
# Accepts JSON POSTs from src/lib/leads.ts; configure CORS and delivery in your provider.
PUBLIC_FORM_ENDPOINT=
# Only for services that want a key in the request body (Web3Forms: https://api.web3forms.com/submit). Public, not a secret.
PUBLIC_FORM_ACCESS_KEY=
# The public scheduling page supplied by G-Force.
PUBLIC_BOOKING_URL=
# Ownership codes from Google Search Console and Bing Webmaster Tools (HTML tag method). Public.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
# The contact email API (contact-api/, on Railway), e.g. https://<service>.up.railway.app/api/contact.
# Public URL only: the SMTP credentials are set on Railway, never here.
PUBLIC_CONTACT_API_URL=
