# Set these in Railway (service → Variables). Never commit real values.
# Google Workspace / Gmail: smtp.gmail.com, port 465 (implicit TLS), and an App Password for SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@gforceit.ca
SMTP_PASSWORD=
# Where enquiries are delivered.
CONTACT_TO_EMAIL=info@gforceit.ca
# Comma-separated website origins allowed to call the API (no trailing slash).
ALLOWED_ORIGINS=https://www.gforceit.ca,https://gforceit.ca
# Optional: sender display name (the sender address is always SMTP_USER unless SMTP_FROM is set to another
# address the account is allowed to send as).
SMTP_FROM_NAME=G-Force IT website
# Optional tuning: per-IP limit per 10 minutes (default 5) and overall limit per hour (default 100).
RATE_LIMIT_MAX=5
RATE_LIMIT_GLOBAL_MAX=100
